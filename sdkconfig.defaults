# Rust often needs a bit of extra main task stack size compared to C (default is 3K).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Increase a bit — also too small by default for std/Rust.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# --- Classic BT + A2DP sink (external-codec API on mainline IDF) ---
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BT_BTC_TASK_STACK_SIZE=15000

# A2DP receives raw AAC/SBC frames; host decodes via esp_audio_codec.
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_A2DP_USE_EXTERNAL_CODEC=y
CONFIG_BT_A2DP_CODEC_AAC_ENABLED=y
CONFIG_BT_A2DP_SEP_NUM_MAX=3

# HFP HF (kept on for future call work — not exercised in this smoke test).
CONFIG_BT_HFP_ENABLE=n
CONFIG_BT_HFP_CLIENT_ENABLE=n
CONFIG_BT_HFP_AUDIO_DATA_PATH_HCI=n
CONFIG_BT_HFP_WBS_ENABLE=n
CONFIG_BT_SSP_ENABLED=n

# --- esp_audio_codec: enable decoders we want compiled in ---
# These also light up cfg(esp_idf_audio_decoder_*_support) for the
# per-codec submodules of the esp-audio-codec crate.
CONFIG_AUDIO_DECODER_AAC_SUPPORT=y
CONFIG_AUDIO_DECODER_SBC_SUPPORT=y

# --- PSRAM: 8 MB QIO @ 80 MHz on chip rev v3.x ---
# Routes large allocations through external SPI RAM via the system
# malloc; small allocs (< MALLOC_ALWAYSINTERNAL) stay in DRAM where they
# don't incur cache-miss latency. 80 MHz PSRAM requires 80 MHz flash on
# ESP32 (shared SPI bus); the cache workaround is auto-applied for
# classic ESP32 rev 1+.
CONFIG_SPIRAM=n
CONFIG_SPIRAM_MODE_QUAD=n
CONFIG_SPIRAM_TYPE_AUTO=n
CONFIG_SPIRAM_SPEED_80M=n
CONFIG_ESPTOOLPY_FLASHFREQ_80M=n
CONFIG_SPIRAM_BOOT_INIT=n
CONFIG_SPIRAM_USE_MALLOC=n
CONFIG_SPIRAM_MEMTEST=n
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=n
